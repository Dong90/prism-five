{
  "name": "prism-five",
  "version": "0.1.0",
  "private": true,
  "description": "5-prism data pipeline — incidence, refraction, dispersion, absorption, emission",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint packages/ && prettier --check packages/",
    "lint:fix": "eslint --fix packages/ && prettier --write packages/",
    "clean": "rm -rf packages/*/dist tsconfig.build.tsbuildinfo",
    "bench": "vitest bench",
    "typecheck": "tsc -b --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.4",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "commander": "^15.0.0",
    "zod": "^4.4.3"
  }
}
